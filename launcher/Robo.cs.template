// Robo.exe - double-click launcher for kid_cli.py. Generated by build_robo_exe.py; edit the template, not the .cs.
// Written for the C# 5 compiler that ships with Windows (.NET Framework 4), so no newer syntax.
using System;
using System.Diagnostics;
using System.IO;
using System.Net;
using System.Text;
using System.Threading;

class Robo
{
    const string Python = @"{{PYTHON}}";
    const string Project = @"{{PROJECT}}";

    static int Main()
    {
        Console.Title = "Robo";
        try { Console.OutputEncoding = Encoding.UTF8; } catch { }
        // Ctrl+C belongs to Robo (it stops a running job); the launcher must not die and close the window.
        Console.CancelKeyPress += (s, e) => { e.Cancel = true; };

        // One Robo at a time: a second copy would load Laya (~2GB) again and push the laptop into swapping.
        bool first;
        using (var only = new Mutex(true, @"Local\RoboSoftwareFactory", out first))
        {
            if (!first)
            {
                Fail("I'm already open in another window! Look for the Robo window.");
                return 2;
            }
            return Run();
        }
    }

    static int Run()
    {

        string script = Path.Combine(Project, "kid_cli.py");
        if (!File.Exists(Python) || !File.Exists(script))
        {
            Fail("I can't find my files. Ask a grown-up to run build_robo_exe.py again.\n" +
                 "     Looked for: " + Python + "\n     and: " + script);
            return 1;
        }

        if (!OllamaUp())
        {
            Say("[o_o]  Waking up my brain...", ConsoleColor.Yellow);
            StartOllama();
            for (int i = 0; i < 60 && !OllamaUp(); i++) Thread.Sleep(1000);
            if (!OllamaUp())
            {
                Fail("My brain (Ollama) didn't wake up. Ask a grown-up to open the Ollama app.");
                return 1;
            }
        }

        var psi = new ProcessStartInfo(Python, "\"" + script + "\"");
        psi.WorkingDirectory = Project;
        psi.UseShellExecute = false;
        psi.EnvironmentVariables["PYTHONIOENCODING"] = "utf-8";
        Process robo = Process.Start(psi);
        robo.WaitForExit();
        if (robo.ExitCode != 0)
        {
            Fail("Oops, I stopped by accident. A grown-up can look in logs\\factory.log.");
        }
        return robo.ExitCode;
    }

    static bool OllamaUp()
    {
        try
        {
            var req = (HttpWebRequest)WebRequest.Create("http://127.0.0.1:11434/api/version");
            req.Timeout = 2000;
            using (req.GetResponse()) { return true; }
        }
        catch { return false; }
    }

    static void StartOllama()
    {
        string app = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
                                  @"Programs\Ollama\ollama app.exe");
        try
        {
            if (File.Exists(app))
            {
                Process.Start(app);
            }
            else
            {
                var psi = new ProcessStartInfo("ollama", "serve");
                psi.UseShellExecute = false;
                psi.CreateNoWindow = true;
                Process.Start(psi);
            }
        }
        catch { }
    }

    static void Say(string message, ConsoleColor color)
    {
        Console.ForegroundColor = color;
        Console.WriteLine("\n  " + message);
        Console.ResetColor();
    }

    static void Fail(string message)
    {
        Say("[;_;]  " + message, ConsoleColor.Red);
        if (Console.IsInputRedirected) return;  // ReadKey throws without a real keyboard
        Console.WriteLine("\n  Press any key to close.");
        Console.ReadKey(true);
    }
}
